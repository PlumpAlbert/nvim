{
	"options": {
		"wrap": false,
		"theme": "base16-catppuccin",
		"indent": 4,
		"rulers": [
			120
		],
		"useTabs": true,
		"lineNumbers": "both"
	},
	"formatters": {
		"typescript": [
			"prettier"
		],
		"typescriptreact": [
			"prettier"
		],
		"javascript": [
			"prettier"
		],
		"javascriptreact": [
			"prettier"
		],
		"json": [
			"prettier"
		],
		"jsonc": [
			"prettier"
		]
	},
	"lspconfig": {
		"vtsls": {
			"vtsls.autoUseWorkspaceTsdk": true
		}
	}
}
